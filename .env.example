# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Session pooler URI from Supabase > Project Settings > Database
DATABASE_URL=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google Calendar (separate OAuth client from Supabase Auth's) ---
# Authorized redirect URI: ${NEXT_PUBLIC_APP_URL}/api/google/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Secrets ---
# 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Guards /api/sync/* cron entrypoints: openssl rand -hex 32
CRON_SECRET=
